{
  "name": "int-center-luggage-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 execute center-luggage-db --local --file=src/schema.sql",
    "db:migrate:prod": "wrangler d1 execute center-luggage-db --remote --file=src/schema.sql",
    "backfill:cash-closing": "node scripts/backfill-cash-closings-from-check-sheet.mjs",
    "sync:cash-closing-staff": "node scripts/sync-cash-closing-staff-ids.mjs",
    "backfill:daily-sales": "node scripts/backfill-daily-sales-from-sheet.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check-customer-assets.mjs",
    "check:customer-assets": "node scripts/check-customer-assets.mjs",
    "check:static-assets": "node scripts/check-customer-assets.mjs",
    "check:schema-drift": "node scripts/check-schema-drift.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@cloudflare/workers-types": "^4.20250305.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.29.3"
}
